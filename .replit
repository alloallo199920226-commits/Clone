modules = ["web", "nodejs-20", "postgresql-16", "python-base-3.13"]
run = "uv run python server.py"
[nix]
channel = "stable-25_05"
packages = ["postgresql", "unzip"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uv run python server.py"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 23636
externalPort = 3000

[deployment]
deploymentTarget = "autoscale"
run = ["uv", "run", "--no-sync", "python", "server.py"]
build = ["uv", "sync", "--frozen", "--no-python-downloads"]
